{
  "rules": {
    "sessions": {
      "$sessionId": {
        "meta": {
          ".read": true,
          ".write": "auth != null"
        },
        "players": {
          ".read": true,
          "$playerId": {
            ".write": true
          }
        }
      }
    },
    "sessions_questions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "session_codes": {
      ".read": true,
      ".write": "auth != null"
    },
    "session_pub_questions": {
      "$sessionId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "teacher_sessions": {
      "$teacherId": {
        ".read": "auth != null && auth.uid == $teacherId",
        ".write": "auth != null && auth.uid == $teacherId"
      }
    },
    "battle_lobby": {
      "$sessionCode": {
        ".read": true,
        ".write": true
      }
    },
    "battles": {
      "$battleId": {
        "meta": {
          ".read": true,
          ".write": true
        },
        "questions": {
          ".read": true,
          ".write": true
        },
        "scores": {
          ".read": true,
          "$playerId": {
            ".write": true
          }
        }
      }
    },
    "battle_invites": {
      "$playerId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
