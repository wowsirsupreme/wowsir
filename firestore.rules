rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Questions: teachers can write, everyone can read approved
    match /questions/{qId} {
      allow read: if resource.data.approvalStatus == 'approved';
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Quizzes: only owning teacher can read/write
    match /quizzes/{qId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.teacherId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.teacherId;
    }

    // Users: read own, teachers can write own
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Results: teacher who owns session can read
    match /results/{resultId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Preset quizzes: anyone can read active ones; teachers can write
    match /presetQuizzes/{pqId} {
      allow read: if resource.data.isActive == true;
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Practice leaderboard: public read + create (no auth — students use display names)
    match /practiceLeaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name','score','gradeKey','level','accuracy','streak','timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.gradeKey is string
        && request.resource.data.level is number
        && request.resource.data.accuracy is number
        && request.resource.data.streak is number;
    }
  }
}
