rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read/write own profile only
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Questions: teachers can read/write all; students can read (filtering is
    // done at query level with where('approvalStatus','==','approved') —
    // resource.data is unavailable in collection scans so we can't use it here)
    match /questions/{qId} {
      allow read: if request.auth != null;
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Quizzes: only the owning teacher can read/write
    // list queries need the broader "authenticated" read so the where-clause can filter;
    // security is enforced by always querying where('teacherId','==', uid).
    match /quizzes/{qId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.teacherId;
    }

    // Results: teachers can create their own session results; anyone auth can read.
    // Students cannot directly write to this collection — results are written
    // server-side (or by the teacher's authenticated session) only.
    match /results/{resultId} {
      allow read: if request.auth != null;
      // Only the teacher who owns the quiz/session may create a result record.
      // The teacherId field in the result document must match the authenticated user.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['id','sessionId','quizId','teacherId','completedAt'])
        && request.resource.data.teacherId == request.auth.uid;
      // Results are immutable once written — no updates or deletes from clients.
      allow update, delete: if false;
    }

    // Papers: teachers can read/write their own papers; subcollection path is
    // papers/{teacherId}/items/{paperId}
    match /papers/{teacherId}/items/{paperId} {
      allow read, write: if request.auth != null && request.auth.uid == teacherId;
    }

    // Preset quizzes: public read — students are unauthenticated guests so
    // request.auth is null; this is safe because presetQuizzes is a public
    // catalog (no PII, no sensitive data). Teachers can write.
    match /presetQuizzes/{pqId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Study Corner overrides: public read — unauthenticated students need this
    // to load teacher-customised notes and keywords on the study page.
    // Only teachers may write.
    match /studyOverrides/{chapterKey} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Practice leaderboard: public read + create (no auth — students use display names)
    match /practiceLeaderboard/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name','score','gradeKey','level','accuracy','streak','timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000   // reasonable upper bound
        && request.resource.data.gradeKey is string
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.level <= 100
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.streak is number
        && request.resource.data.streak >= 0
        && request.resource.data.streak <= 1000;
      allow update, delete: if false;
    }
  }
}
